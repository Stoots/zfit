#!/bin/sh
# Stale node_modules after a pull or upstream sync broke server boot (missing `sharp`).
# $1 is 1 for a squash merge, which leaves HEAD in place and stages the result.
if [ "$1" = 1 ]; then changed=$(git diff --cached --name-only); else changed=$(git diff --name-only ORIG_HEAD HEAD); fi
if printf '%s\n' "$changed" | grep -qx pnpm-lock.yaml; then
  pnpm install --frozen-lockfile
fi
