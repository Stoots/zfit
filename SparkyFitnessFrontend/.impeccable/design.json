      "css": ".ds-field{display:grid;gap:8px;color:hsl(var(--foreground));font:400 16px var(--font-sans, 'Figtree Variable', sans-serif);}.ds-input{min-width:0;height:44px;border:1px solid hsl(var(--input));border-radius:var(--radius);background:hsl(var(--background));color:hsl(var(--foreground));padding:8px 12px;font:inherit;}.ds-input::placeholder{color:hsl(var(--muted-foreground));}.ds-input:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background)),0 0 0 4px hsl(var(--ring));}.ds-input:disabled{cursor:not-allowed;opacity:0.5;}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat bordered container with title and content spacing.",
      "html": "<article class=\"ds-card\"><header class=\"ds-card-header\"><h3 class=\"ds-card-title\">Summary</h3></header><div class=\"ds-card-content\">Your recorded entries appear here.</div></article>",
      "css": ".ds-card{min-width:0;border:1px solid hsl(var(--border));border-radius:var(--radius);background:hsl(var(--card));color:hsl(var(--card-foreground));font:400 16px var(--font-sans, 'Figtree Variable', sans-serif);}.ds-card-header{padding:24px;}.ds-card-title{margin:0;font-size:20px;font-weight:600;line-height:1.375;letter-spacing:-0.025em;}.ds-card-content{padding:0 24px 24px;}"
    },
    {
      "name": "Macro chip",
      "kind": "chip",
      "refersTo": "macro-chip",
      "description": "Informational chip; preview uses an empty value rather than user data.",
      "html": "<span class=\"ds-macro\"><span class=\"ds-macro-dot\" aria-hidden=\"true\"></span>Protein <span class=\"ds-macro-value\">— g</span></span>",
      "css": ".ds-macro{display:inline-flex;align-items:center;gap:8px;border:1px solid hsl(var(--border));border-radius:calc(infinity * 1px);padding:6px 12px;color:hsl(var(--foreground));font:400 12px/16px var(--font-sans, 'Figtree Variable', sans-serif);}.ds-macro-dot{width:6px;height:6px;border-radius:calc(infinity * 1px);background:var(--protein);}.ds-macro-value{font-weight:500;font-variant-numeric:tabular-nums;}"
    },
