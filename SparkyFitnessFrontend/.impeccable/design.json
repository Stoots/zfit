  "narrative": {
    "northStar": "A calm instrument for one number at a time",
    "overview": "Night-navy surfaces, rounded numerals and quiet hairline rows make daily health data easy to scan on a phone. Dark is the hero treatment; light remains a complete theme. Periwinkle signals interaction while domain colors identify information.\n\nThis captures the implemented foundation: tokens, shared primitives, metric components and app navigation. Page compositions remain in the [surface brief](.impeccable/surfaces/src-layouts-mainlayout-tsx.md); their redesign is separate work. The existing SparkyFitness logo remains the identity asset. No new shipping raster artwork is part of this foundation.",
    "keyCharacteristics": [
      "One prominent rounded metric with a small text unit.",
      "Hairline rows and restrained surfaces.",
      "Foreground-filled pill actions and periwinkle navigation states.",
      "Static dark-only ambient color, with useful data carrying the visual weight."
    ],
    "rules": [
      {
        "name": "The Action Fill Rule",
        "body": "Use `primary-fill` with `background` text for the main CTA. It follows the foreground color in each theme. Use `primary` with `primary-foreground` only when an accent-filled action is intended.",
        "section": "colors"
      },
      {
        "name": "The Token Format Rule",
        "body": "Most raw variables contain HSL triples: use `hsl(var(--nutrition))` or Tailwind `bg-nutrition`. Protein, carbs and fat contain complete hex colors: use `var(--protein)` or `bg-protein`, never wrap them in `hsl()`. Preserve these representations when adding chart styles.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use semantic theme variables and their paired foregrounds.",
      "Do reserve rounded numeral type for metrics, with Figtree labels and units.",
      "Do reuse the metric components with real values and translated labels.",
      "Do check both themes at 390px and desktop widths, including keyboard focus and long labels.",
      "Do preserve permissions, routes and existing interactions when applying the visual system."
    ],
    "donts": [
      "Don't substitute the periwinkle accent for the foreground-filled default CTA.",
      "Don't wrap protein, carbs or fat variables in `hsl()`.",
      "Don't add ring dashboards or multicolored card grids to express the pinned visual direction; use a lead metric and quiet rows.",
      "Don't treat primitive captures as authenticated page acceptance or a completed page redesign."
    ]
  }
}
