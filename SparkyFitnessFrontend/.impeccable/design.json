      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Button variant=\"default\".",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Continue</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:calc(infinity * 1px);font:500 14px/20px var(--font-sans, 'Figtree Variable', sans-serif);height:44px;padding:8px 20px;transition:background-color 150ms cubic-bezier(0.4,0,0.2,1),color 150ms cubic-bezier(0.4,0,0.2,1);background:hsl(var(--primary-fill));color:hsl(var(--background));border:0;}.ds-button-primary:hover{background:hsl(var(--primary-fill) / 0.9);}.ds-button-primary:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background)),0 0 0 4px hsl(var(--ring));}.ds-button-primary:disabled{pointer-events:none;opacity:0.5;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition-duration:0.01ms;}}@media(pointer:coarse){.ds-button-primary{min-height:44px;min-width:44px;}}"
